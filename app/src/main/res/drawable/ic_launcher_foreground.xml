<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Subtle Drop Shadow for 3D effect -->
    <path
        android:fillColor="#22000000"
        android:pathData="M 136 245 A 125 125 0 0 1 386 245 L 386 260 Q 386 275 371 275 L 141 275 Q 126 275 126 260 Z" />

    <!-- Jellyfish Dome with Radial Gradient for 3D depth -->
    <path android:pathData="M 131 235 A 125 125 0 0 1 381 235 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="256"
                android:centerY="200"
                android:gradientRadius="150"
                android:type="radial">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#E0E0E0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dome Base (Pill Shape) -->
    <path android:pathData="M 116 220 L 396 220 Q 411 220 411 235 Q 411 250 396 250 L 116 250 Q 101 250 101 235 Q 101 220 116 220 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="101"
                android:startY="235"
                android:endX="411"
                android:endY="235"
                android:type="linear">
                <item android:color="#F5F5F5" android:offset="0" />
                <item android:color="#FFFFFF" android:offset="0.5" />
                <item android:color="#F5F5F5" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tentacles with linear gradients for depth -->
    <!-- Outer Left -->
    <path android:pathData="M 156 240 L 176 240 L 176 350 Q 176 360 166 360 Q 156 360 156 350 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="166" android:startY="240" android:endX="166" android:endY="360" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#D1D1D1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Left -->
    <path android:pathData="M 201 240 L 221 240 L 221 380 Q 221 390 211 390 Q 201 390 201 380 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="211" android:startY="240" android:endX="211" android:endY="390" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#D1D1D1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center -->
    <path android:pathData="M 246 240 L 266 240 L 266 410 Q 266 420 256 420 Q 246 420 246 410 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="256" android:startY="240" android:endX="256" android:endY="420" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#D1D1D1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Right -->
    <path android:pathData="M 291 240 L 311 240 L 311 380 Q 311 390 301 390 Q 291 390 291 380 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="301" android:startY="240" android:endX="301" android:endY="390" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#D1D1D1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Right -->
    <path android:pathData="M 336 240 L 356 240 L 356 350 Q 356 360 346 360 Q 336 360 336 350 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="346" android:startY="240" android:endX="346" android:endY="360" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#D1D1D1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
