<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for devices running Android 12 (API 31) and above.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
    for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include DataStore preferences (app settings) -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore"/>

        <!-- Exclude sensitive/temporary data -->
        <exclude domain="sharedpref" path="device.xml"/>

        <!-- EncryptedSharedPreferences files: the master key lives in
             AndroidKeystore and is NEVER backed up or transferred, so a
             restored ciphertext is undecryptable forever and only poisons
             the next launch (issue #171's fresh-install crash loop — every
             read threw "Signature/MAC verification failed" out of the
             startup Koin graph). The storage seam additionally wipes a
             poisoned file if one still arrives. -->
        <exclude domain="sharedpref" path="seerr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="arr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="subtitle_provider_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="client_certificate_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include DataStore preferences (app settings) -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore"/>

        <!--
            The database is excluded from device-to-device transfer because it contains Jellyfin access
            tokens (now encrypted at rest via TokenCipher, §4.10) and per-user playback
            history that shouldn't migrate to a different physical device without the user's
            explicit action. It is excluded implicitly by not being listed under <include>.
            The encrypted Seerr credential store is also excluded by virtue
            of being in sharedpref/device.xml.
        -->
        <exclude domain="sharedpref" path="device.xml"/>

        <!-- Same keystore-master-key reasoning as cloud-backup above: the
             encrypted files cannot be decrypted on the receiving device. -->
        <exclude domain="sharedpref" path="seerr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="arr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="subtitle_provider_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="client_certificate_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
