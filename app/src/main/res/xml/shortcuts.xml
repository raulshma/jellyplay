    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads_short"
        android:shortcutLongLabel="@string/shortcut_downloads_long">
        <intent
            android:action="com.raulshma.jellyplay.action.DOWNLOADS"
            android:targetPackage="com.raulshma.jellyplay"
            android:targetClass="com.raulshma.jellyplay.MainActivity" />
    </shortcut>
</shortcuts>
