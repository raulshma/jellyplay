<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lr_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_item_background"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/lr_item_poster"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_backdrop_placeholder" />

    <LinearLayout
        android:id="@+id/lr_item_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_scrim"
        android:minHeight="32dp"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/lr_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lr_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#BBFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
