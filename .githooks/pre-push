#!/bin/bash
# pre-push — verify the modules a push would change BEFORE CI ever sees them.
#
# Why: CI (kmp-build.yml) runs on PRs and main/kmp-alpha pushes only; dev/*
# branches have no required checks, so an unverified push lands on the PR
# queue cold. The dev/v0.10.6 merges shipped three test regressions exactly
# this way (see the `push:` trigger comment in kmp-build.yml). This hook
# re-uses CI's own derivation idea (settings.gradle.kts is the single source
# of truth) but bounds the work to the modules the pushed commits touch.
#
# Scope: shared modules' jvmTest (+ compileAndroidMain / testAndroidHostTest
# when their androidMain moved — ADR-0006 lane vocabulary), :app unit tests
# when app/ moved, :apps:desktop:test when the desktop shell moved.
# Docs/website-only pushes skip entirely, mirroring CI's paths-ignore.
#
# Wire-up on a fresh clone (core.hooksPath is repo-local git config, not
# versioned):   git config core.hooksPath .githooks
# Escape hatch: JELLYPLAY_SKIP_PREPUSH=1 git push
# Dry run:      JELLYPLAY_PREPUSH_DRYRUN=1 git push

set -eu

if [ "${JELLYPLAY_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: skipped (JELLYPLAY_SKIP_PREPUSH=1)"
  exit 0
fi

# Each stdin line: <local ref> <local oid> <remote ref> <remote oid>.
changed=""
while read -r local_ref local_oid remote_ref remote_oid; do
  # Branch deletion — nothing to verify.
  case "$local_oid" in 0*) continue ;; esac
  case "$remote_oid" in
    0*)
      # New branch — verify everything since the merge-base with main.
      base=$(git merge-base origin/main "$local_oid" 2>/dev/null || true)
      if [ -n "$base" ]; then
        changed="$changed
$(git diff --name-only "$base..$local_oid")"
      else
        # No main to diff against — verify the tip commit alone.
        changed="$changed
$(git diff-tree --no-commit-id --name-only -r "$local_oid")"
      fi
      ;;
    *)
      changed="$changed
$(git diff --name-only "$remote_oid..$local_oid")"
      ;;
  esac
done

changed=$(printf '%s\n' "$changed" | sed '/^$/d')
if [ -z "$changed" ]; then
  echo "pre-push: no changed files detected — nothing to verify"
  exit 0
fi

# Doc/website-only pushes skip, matching kmp-build.yml's paths-ignore.
non_doc=$(printf '%s\n' "$changed" | grep -vE '(^docs/|^website/|\.md$|^fastlane/metadata/)' || true)
if [ -z "$non_doc" ]; then
  echo "pre-push: docs/website-only push — skipping (CI paths-ignore equivalent)"
  exit 0
fi

# Map changed paths to Gradle modules: everything between "shared/" and
# "/src/" is the module path, "/"→":" for the Gradle colon notation.
modules=""; app_changed=0; desktop_changed=0
while IFS= read -r path; do
  case "$path" in
    app/*)          app_changed=1 ;;
    apps/desktop/*) desktop_changed=1 ;;
    shared/*/src/*)
      m=":shared:$(printf '%s' "$path" | sed -E 's#^shared/##; s#/src/.*##' | tr '/' ':')"
      modules="$modules $m"
      ;;
  esac
done <<EOF2
$changed
EOF2

# Validate against the settings.gradle.kts include list (same derivation CI
# uses) so a wrong mapping fails loudly here, not in CI.
includes=$(grep -oE 'include\("(:shared:[^"]+)"\)' settings.gradle.kts | sed -E 's/^include\("([^"]+)"\)$/\1/')
tasks=""
for m in $(printf '%s\n' $modules | sort -u); do
  if ! printf '%s\n' "$includes" | grep -qx "$m"; then
    echo "pre-push: ERROR: '$m' mapped from changed files is not an include in settings.gradle.kts — fix the mapping in this hook."
    exit 1
  fi
  tasks="$tasks $m:jvmTest"
  # androidMain moved in this module? Verify the Android compilation, and the
  # Robolectric host lane only where the module opted in via withHostTest
  # (the lane does not exist on every module — CI names just five).
  dir=$(printf '%s' "$m" | sed 's/^://; s#:#/#g')
  if printf '%s\n' "$changed" | grep -q "^$dir/src/androidMain/"; then
    tasks="$tasks $m:compileAndroidMain"
    if grep -q "withHostTest" "$dir/build.gradle.kts" 2>/dev/null; then
      tasks="$tasks $m:testAndroidHostTest"
    fi
  fi
done

if [ "$app_changed" = "1" ]; then
  tasks="$tasks :app:testPhoneStoreDebugUnitTest"
fi
if [ "$desktop_changed" = "1" ]; then
  tasks="$tasks :apps:desktop:test"
fi

tasks=$(printf '%s\n' $tasks | sort -u | tr '\n' ' ')
if [ -z "$(printf '%s' "$tasks" | tr -d ' ')" ]; then
  echo "pre-push: push touches no verifiable Gradle module (docs/config/plugin tree?) — skipping"
  exit 0
fi

echo "pre-push: verifying lanes:$tasks"
if [ "${JELLYPLAY_PREPUSH_DRYRUN:-}" = "1" ]; then
  echo "pre-push: dry run — Gradle not invoked"
  exit 0
fi

exec ./gradlew $tasks --stacktrace
