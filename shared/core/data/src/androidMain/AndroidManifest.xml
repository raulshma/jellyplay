<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 "Live Updates": user-granted special access letting the
         download-progress notification be promoted to the top of the shade.
         Declared so the Settings opt-in row can deep-link the grant screen. -->
    <uses-permission android:name="android.permission.UPDATE_OWN_LIVE_UPDATE" />

    <application>
        <receiver
            android:name="com.raulshma.jellyplay.core.data.receiver.DownloadActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.raulshma.jellyplay.download.PAUSE" />
                <action android:name="com.raulshma.jellyplay.download.RESUME" />
                <action android:name="com.raulshma.jellyplay.download.CANCEL" />
            </intent-filter>
        </receiver>

        <!-- Fully qualified: the Kotlin package (com.raulshma.jellyplay.core.data.playback)
             does not contain this module's namespace segment `.shared`, so a relative
             `.playback.JellyPlayPlaybackService` resolves to a nonexistent class and the
             service silently never starts (no media notification). -->
        <service
            android:name="com.raulshma.jellyplay.core.data.playback.JellyPlayPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
